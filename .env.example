# ─────────────────────────────────────────────────────────────────────────────
# ChatAcredita PRO — Environment variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# OpenRouter API key (required by all systems)
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE

# Qdrant Cloud (required by all systems)
QDRANT_URL=https://YOUR_CLUSTER.qdrant.io
QDRANT_API_KEY=YOUR_QDRANT_KEY
QDRANT_COLLECTION=acreditacion

# ── Sys-B (RAFT) only ────────────────────────────────────────────────────────
RAFT_DATASET=dataset_raft_v4.json   # path to CNA-EISC-RAFT-58K local file

# ── Long-Context mode (Sys-A, Sys-C) ─────────────────────────────────────────
PDF_DIR=pdfs/                        # folder containing source PDFs
LC_CORPUS_CACHE=corpus_lc.pkl        # cached Markdown corpus (auto-built)

# ── Model overrides (optional) ────────────────────────────────────────────────
GEN_MODEL=deepseek/deepseek-r1-0528
ORCHESTRATOR_MODEL=deepseek/deepseek-r1-0528
VALIDATOR_MODEL=google/gemma-3-12b-it
EVAL_MODEL=qwen/qwen3-32b
EVAL_FALLBACK=deepseek/deepseek-r1-0528
FAST_EVAL=qwen/qwen3-8b:free
